# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.serafimdogtraining.com

# ── Calendly ─────────────────────────────────────────────────────────────────
# Paste the embed URL from your Calendly event
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/YOUR_HANDLE/consult

# ── Skool ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SKOOL_URL=https://www.skool.com/YOUR_COMMUNITY

# ── MailerLite ───────────────────────────────────────────────────────────────
# Used by /api/subscribe to add Handler's Playbook leads to a MailerLite group.
# Generate a token in MailerLite → Integrations → API.
MAILERLITE_API_KEY=your_key_here
# Group ID for the "Off-Leash Reliability Playbook" list, used by
# /api/off-leash-guide/subscribe. Falls back to the Handler's Playbook group
# if unset. Find it in MailerLite → Subscribers → Groups.
MAILERLITE_OFF_LEASH_GROUP_ID=
